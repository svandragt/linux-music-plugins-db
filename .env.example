# Host port for direct access (docker-compose.yml on its own).
HTTP_PORT=8080

# Subdomain to serve on, used by the Traefik overlay.
SITE_HOST=yabridge.localhost

# Existing external Docker network that Traefik watches.
TRAEFIK_NETWORK=web

# Traefik certificate resolver name.
TRAEFIK_CERT_RESOLVER=letsencrypt
